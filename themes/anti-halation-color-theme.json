{
  "name": "Warm Anti-Halation Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1c1b1a",
    "editor.foreground": "#ccbeaf",
    "editorCursor.foreground": "#e69c43",
    "editor.lineHighlightBackground": "#262422",
    "editor.selectionBackground": "#3d3731",
    "editor.inactiveSelectionBackground": "#2c2824",
    "editor.wordHighlightBackground": "#332f2a",
    "editorLineNumber.foreground": "#6b635a",
    "editorLineNumber.activeForeground": "#e69c43",
    "editorWhitespace.foreground": "#38332e",
    "editorIndentGuide.background1": "#2b2724",
    "editorIndentGuide.activeBackground1": "#4a443e",
    "editorBracketMatch.background": "#2b2724",
    "editorBracketMatch.border": "#e69c43",
    "editorLink.activeForeground": "#e88368",
    "sideBar.background": "#171615",
    "sideBar.foreground": "#b3a79b",
    "sideBar.border": "#262422",
    "sideBarTitle.foreground": "#ccbeaf",
    "sideBarSectionHeader.background": "#211f1e",
    "sideBarSectionHeader.foreground": "#ccbeaf",
    "activityBar.background": "#141312",
    "activityBar.foreground": "#e69c43",
    "activityBar.inactiveForeground": "#736a60",
    "activityBarBadge.background": "#e69c43",
    "activityBarBadge.foreground": "#1c1b1a",
    "editorGroupHeader.tabsBackground": "#141312",
    "tab.activeBackground": "#1c1b1a",
    "tab.activeForeground": "#ccbeaf",
    "tab.inactiveBackground": "#171615",
    "tab.inactiveForeground": "#736a60",
    "tab.border": "#262422",
    "tab.activeBorderTop": "#e69c43",
    "statusBar.background": "#141312",
    "statusBar.foreground": "#b3a79b",
    "statusBar.border": "#262422",
    "statusBar.noFolderBackground": "#141312",
    "statusBar.noFolderForeground": "#b3a79b",
    "statusBar.noFolderBorder": "#262422",
    "statusBar.debuggingBackground": "#e69c43",
    "statusBar.debuggingForeground": "#1c1b1a",
    "statusBarItem.remoteBackground": "#e69c43",
    "statusBarItem.remoteForeground": "#1c1b1a",
    "titleBar.activeBackground": "#141312",
    "titleBar.activeForeground": "#ccbeaf",
    "titleBar.inactiveBackground": "#171615",
    "titleBar.inactiveForeground": "#736a60",
    "input.background": "#211f1e",
    "input.foreground": "#ccbeaf",
    "input.border": "#38332e",
    "input.placeholderForeground": "#736a60",
    "inputOption.activeBorder": "#e69c43",
    "dropdown.background": "#211f1e",
    "dropdown.foreground": "#ccbeaf",
    "dropdown.border": "#38332e",
    "list.hoverBackground": "#262422",
    "list.activeSelectionBackground": "#3d3731",
    "list.activeSelectionForeground": "#ccbeaf",
    "list.inactiveSelectionBackground": "#262422",
    "list.inactiveSelectionForeground": "#ccbeaf",
    "terminal.background": "#1c1b1a",
    "terminal.foreground": "#ccbeaf",
    "terminal.ansiBlack": "#1c1b1a",
    "terminal.ansiRed": "#e88368",
    "terminal.ansiGreen": "#93b870",
    "terminal.ansiYellow": "#e69c43",
    "terminal.ansiBlue": "#93b870",
    "terminal.ansiMagenta": "#c97bb2",
    "terminal.ansiCyan": "#d6a75c",
    "terminal.ansiWhite": "#ccbeaf",
    "terminal.ansiBrightBlack": "#736a60",
    "terminal.ansiBrightRed": "#f0957d",
    "terminal.ansiBrightGreen": "#a4c781",
    "terminal.ansiBrightYellow": "#f0ac59",
    "terminal.ansiBrightBlue": "#a4c781",
    "terminal.ansiBrightMagenta": "#d98ec3",
    "terminal.ansiBrightCyan": "#e6b86e",
    "terminal.ansiBrightWhite": "#ffffff",
    "gitDecoration.modifiedResourceForeground": "#e69c43",
    "gitDecoration.deletedResourceForeground": "#e88368",
    "gitDecoration.untrackedResourceForeground": "#93b870",
    "gitDecoration.ignoredResourceForeground": "#6b635a"
  },
  "tokenColors": [
    {
      "name": "Komentarze",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8a8073", "fontStyle": "italic" }
    },
    {
      "name": "Słowa kluczowe i modyfikatory",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": { "foreground": "#e69c43" }
    },
    {
      "name": "Dyrektywy preprocesora i include",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "keyword.control.import",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#e88368" }
    },
    {
      "name": "Ciągi znaków",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "constant.character.escape"
      ],
      "settings": { "foreground": "#e08d48" }
    },
    {
      "name": "Funkcje i metody",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": { "foreground": "#93b870" }
    },
    {
      "name": "Klasy, typy i interfejsy",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#70b8a8", "fontStyle": "bold" }
    },
    {
      "name": "Zmienne i parametry",
      "scope": [
        "variable",
        "meta.variable",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": { "foreground": "#ccbeaf" }
    },
    {
      "name": "Właściwości obiektów",
      "scope": ["variable.other.property", "support.type.property-name"],
      "settings": { "foreground": "#d6a75c" }
    },
    {
      "name": "Stałe, liczby i wartości logiczne",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": { "foreground": "#e39047" }
    },
    {
      "name": "Znaczniki HTML/XML",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#e69c43" }
    },
    {
      "name": "Atrybuty HTML/XML",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#d6a75c" }
    },
    {
      "name": "Znaki interpunkcyjne i nawiasy",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#b8ada2" }
    },
    {
      "name": "Markdown - Linki i URL-e",
      "scope": [
        "markup.underline.link",
        "string.other.link.title",
        "string.other.link.description",
        "markup.underline.link.markdown"
      ],
      "settings": { "foreground": "#e39047" }
    },
    {
      "name": "Markdown - Tekst linku / Etykiety",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.title.markdown"
      ],
      "settings": { "foreground": "#93b870" }
    },
    {
      "name": "Markdown - Nawiasy linków i znaki specjalne",
      "scope": [
        "punctuation.definition.link.markdown",
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown"
      ],
      "settings": { "foreground": "#8a8073" }
    },
    {
      "name": "Markdown - Nagłówki",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#e69c43", "fontStyle": "bold" }
    },
    {
      "name": "Markdown - Pogrubienie i Kursywa",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ccbeaf", "fontStyle": "bold" }
    },
    {
      "name": "Markdown - Kod wierszowy",
      "scope": ["markup.inline.raw", "markup.raw.inline.markdown"],
      "settings": { "foreground": "#93b870" }
    },
    {
      "name": "Markdown - Listy i Cytaty",
      "scope": [
        "beginning.punctuation.definition.list.markdown",
        "markup.quote"
      ],
      "settings": { "foreground": "#d6a75c" }
    }
  ]
}
