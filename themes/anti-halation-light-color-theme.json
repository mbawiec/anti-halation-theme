{
  "name": "Warm Anti-Halation Light",
  "type": "light",
  "colors": {
    "editor.background": "#f4efe6",
    "editor.foreground": "#38322d",
    "editorCursor.foreground": "#7a3e00",
    "editor.lineHighlightBackground": "#eae2d3",
    "editor.selectionBackground": "#dbceb6",
    "editor.inactiveSelectionBackground": "#e5dac6",
    "editor.wordHighlightBackground": "#e5dac6",
    "editorLineNumber.foreground": "#8a7e71",
    "editorLineNumber.activeForeground": "#7a3e00",
    "editorWhitespace.foreground": "#d4c8b8",
    "editorIndentGuide.background1": "#e5dac6",
    "editorIndentGuide.activeBackground1": "#b8aa97",
    "editorBracketMatch.background": "#eae2d3",
    "editorBracketMatch.border": "#7a3e00",
    "editorLink.activeForeground": "#942b10",
    "sideBar.background": "#eae3d5",
    "sideBar.foreground": "#3d3731",
    "sideBar.border": "#dfd6c4",
    "sideBarTitle.foreground": "#2d2926",
    "sideBarSectionHeader.background": "#e2dacb",
    "sideBarSectionHeader.foreground": "#2d2926",
    "activityBar.background": "#dfd6c4",
    "activityBar.foreground": "#7a3e00",
    "activityBar.inactiveForeground": "#73675c",
    "activityBarBadge.background": "#7a3e00",
    "activityBarBadge.foreground": "#ffffff",
    "editorGroupHeader.tabsBackground": "#dfd6c4",
    "tab.activeBackground": "#f4efe6",
    "tab.activeForeground": "#2d2926",
    "tab.inactiveBackground": "#eae3d5",
    "tab.inactiveForeground": "#73675c",
    "tab.border": "#dfd6c4",
    "tab.activeBorderTop": "#7a3e00",
    "statusBar.background": "#dfd6c4",
    "statusBar.foreground": "#3d3731",
    "statusBar.border": "#d5cca8",
    "statusBar.noFolderBackground": "#dfd6c4",
    "statusBar.noFolderForeground": "#3d3731",
    "statusBar.noFolderBorder": "#d5cca8",
    "statusBar.debuggingBackground": "#7a3e00",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.remoteBackground": "#7a3e00",
    "statusBarItem.remoteForeground": "#ffffff",
    "titleBar.activeBackground": "#dfd6c4",
    "titleBar.activeForeground": "#2d2926",
    "titleBar.inactiveBackground": "#eae3d5",
    "titleBar.inactiveForeground": "#73675c",
    "input.background": "#fbf8f3",
    "input.foreground": "#2d2926",
    "input.border": "#c2b4a1",
    "input.placeholderForeground": "#73675c",
    "inputOption.activeBorder": "#7a3e00",
    "dropdown.background": "#eae3d5",
    "dropdown.foreground": "#2d2926",
    "dropdown.border": "#c2b4a1",
    "list.hoverBackground": "#eae2d3",
    "list.activeSelectionBackground": "#dbceb6",
    "list.activeSelectionForeground": "#2d2926",
    "list.inactiveSelectionBackground": "#eae2d3",
    "list.inactiveSelectionForeground": "#2d2926",
    "terminal.background": "#f4efe6",
    "terminal.foreground": "#38322d",
    "terminal.ansiBlack": "#2d2926",
    "terminal.ansiRed": "#942b10",
    "terminal.ansiGreen": "#2e4d17",
    "terminal.ansiYellow": "#7a3e00",
    "terminal.ansiBlue": "#2e4d17",
    "terminal.ansiMagenta": "#782847",
    "terminal.ansiCyan": "#6e3f11",
    "terminal.ansiWhite": "#f4efe6",
    "terminal.ansiBrightBlack": "#73675c",
    "terminal.ansiBrightRed": "#a83214",
    "terminal.ansiBrightGreen": "#3f6320",
    "terminal.ansiBrightYellow": "#944c00",
    "terminal.ansiBrightBlue": "#3f6320",
    "terminal.ansiBrightMagenta": "#913257",
    "terminal.ansiBrightCyan": "#824b15",
    "terminal.ansiBrightWhite": "#ffffff",
    "gitDecoration.modifiedResourceForeground": "#7a3e00",
    "gitDecoration.deletedResourceForeground": "#942b10",
    "gitDecoration.untrackedResourceForeground": "#2e4d17",
    "gitDecoration.ignoredResourceForeground": "#8a7e71"
  },
  "tokenColors": [
    {
      "name": "Komentarze",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#75695c", "fontStyle": "italic" }
    },
    {
      "name": "Słowa kluczowe i modyfikatory",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": { "foreground": "#6e3b00" }
    },
    {
      "name": "Dyrektywy preprocesora i include",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "keyword.control.import",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#8f260b" }
    },
    {
      "name": "Ciągi znaków",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "constant.character.escape"
      ],
      "settings": { "foreground": "#942b10" }
    },
    {
      "name": "Funkcje i metody",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": { "foreground": "#2e4d17" }
    },
    {
      "name": "Klasy, typy i interfejsy",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#1d4a3e", "fontStyle": "bold" }
    },
    {
      "name": "Zmienne i parametry",
      "scope": [
        "variable",
        "meta.variable",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": { "foreground": "#38322d" }
    },
    {
      "name": "Właściwości obiektów",
      "scope": ["variable.other.property", "support.type.property-name"],
      "settings": { "foreground": "#6e3f11" }
    },
    {
      "name": "Stałe, liczby i wartości logiczne",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": { "foreground": "#7a2e0a" }
    },
    {
      "name": "Znaczniki HTML/XML",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#6e3b00" }
    },
    {
      "name": "Atrybuty HTML/XML",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#6e3f11" }
    },
    {
      "name": "Znaki interpunkcyjne i nawiasy",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#484037" }
    },
    {
      "name": "Markdown - Linki i URL-e",
      "scope": [
        "markup.underline.link",
        "string.other.link.title",
        "string.other.link.description",
        "markup.underline.link.markdown"
      ],
      "settings": { "foreground": "#7a2e0a" }
    },
    {
      "name": "Markdown - Tekst linku / Etykiety",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.title.markdown"
      ],
      "settings": { "foreground": "#2e4d17" }
    },
    {
      "name": "Markdown - Nawiasy linków i znaki specjalne",
      "scope": [
        "punctuation.definition.link.markdown",
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown"
      ],
      "settings": { "foreground": "#75695c" }
    },
    {
      "name": "Markdown - Nagłówki",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#6e3b00", "fontStyle": "bold" }
    },
    {
      "name": "Markdown - Pogrubienie i Kursywa",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#38322d", "fontStyle": "bold" }
    },
    {
      "name": "Markdown - Kod wierszowy",
      "scope": ["markup.inline.raw", "markup.raw.inline.markdown"],
      "settings": { "foreground": "#2e4d17" }
    },
    {
      "name": "Markdown - Listy i Cytaty",
      "scope": [
        "beginning.punctuation.definition.list.markdown",
        "markup.quote"
      ],
      "settings": { "foreground": "#6e3f11" }
    }
  ]
}
