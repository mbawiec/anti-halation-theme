{
  "name": "anti-halation-theme",
  "displayName": "Warm Anti-Halation Theme",
  "description": "Ergonomic, warm-toned light and dark themes designed for astigmatism and eye strain relief.",
  "version": "1.3.0",
  "publisher": "drone",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbawiec/anti-halation-theme.git"
  },
  "engines": {
